@model UserManagementChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<div class="bg-info py-2">
    <div class="container-fluid">
        <h2 class="d-inline-block text-white">Edit User</h2>
        <div class="d-inline-block float-end py-1">
            <a asp-controller="UserManagement" asp-action="Edit" asp-route-id="@Model.Id"
               style="text-decoration:none" class="text-white">
                <i class="bi bi-arrow-bar-left h3" style="color:white"> Back To Edit User</i>
            </a>
        </div>
    </div>
</div>

<div class="container-fluid py-3">
    <form method="post">
        <input asp-for="Id" hidden />
        <div class="mb-3 row">
            <label asp-for="Password" class="col-sm-2 col-form-label text-white"></label>
            <div class="col-sm-10">
                <input asp-for="Password" class="form-control" id="Password">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3 row">
            <label asp-for="ConfirmPassword" class="col-sm-2 col-form-label text-white"></label>
            <div class="col-sm-10">
                <input asp-for="ConfirmPassword" class="form-control" id="ConfirmPassword">
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <div>            
            <span class="text-danger">@ViewBag.Error</span>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-primary float-end col-sm-2" asp-controller="UserManagement"
                    asp-action="ChangePassword">
                Change Password
            </button>
        </div>
    </form>
</div>