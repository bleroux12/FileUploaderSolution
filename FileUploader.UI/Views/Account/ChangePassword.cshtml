@model AccountChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<div class="bg-info py-2">
    <div class="container-fluid">
        <h2 class="d-inline-block text-white">Edit User</h2>
        <div class="d-inline-block float-end py-1">
            <a asp-controller="Account" asp-action="ViewProfile" style="text-decoration:none">
                <i class="bi bi-arrow-bar-left h3" style="color:white"> Back To View Profile</i>
            </a>
        </div>
    </div>
</div>

<div class="container-fluid py-3">
    <form method="post">
        <div class="mb-3 row">
            <label asp-for="OldPassword" class="col-sm-2 col-form-label text-white"></label>
            <div class="col-sm-10">
                <input asp-for="OldPassword" class="form-control" id="OldPassword">
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3 row">
            <label asp-for="NewPassword" class="col-sm-2 col-form-label text-white"></label>
            <div class="col-sm-10">
                <input asp-for="NewPassword" class="form-control" id="NewPassword">
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3 row">
            <label asp-for="ConfirmPassword" class="col-sm-2 col-form-label text-white"></label>
            <div class="col-sm-10">
                <input asp-for="ConfirmPassword" class="form-control" id="ConfirmPassword">
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <div>
            <span class="text-danger">@ViewBag.Error</span>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-primary float-end col-sm-2" asp-controller="Account"
                    asp-action="ChangePassword">
                Change Password
            </button>
        </div>
    </form>
</div>